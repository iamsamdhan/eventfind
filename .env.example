# EventFind V1 — Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env or secrets to version control.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"

# PostgreSQL Database Connection
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Example for local PostgreSQL 18:
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/eventfind?schema=public"

# Session Security Secret (minimum 32 random characters used for session signing/encryption)
SESSION_SECRET="e9b2c8a74f1d0358296a1b4e7c3d2f109845763214876543210987654321abcd"

# Session Cookie Name (optional override)
SESSION_COOKIE_NAME="eventfind_session"

# Session Cookie Max Age in seconds (default: 604800 = 7 days)
SESSION_MAX_AGE_SECONDS=604800
